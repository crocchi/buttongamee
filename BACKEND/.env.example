# Rinomina questo file in ".env" e inserisci i valori reali (NON committare mai il file ".env" su git)

# Porta su cui parte il server (Hostinger la imposta automaticamente tramite process.env.PORT)
PORT=8000

# Sessione Express
SESSION_SECRET=cambia-questo-valore-con-una-stringa-lunga-e-casuale

# Database MySQL (Hostinger hPanel > Database > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Origini ammesse per CORS, separate da virgola (es. https://tuodominio.com)
CORS_ORIGIN=*
