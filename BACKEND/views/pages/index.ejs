<!DOCTYPE HTML>
<html>
	<head>
			<title>ButtonGame v.0.4 - #js #mysql #nodejs #socket.io #ejs #express - template Aerial by HTML5 UP</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
       	<link crossorigin="anonymous" rel="icon" href="https://latitanti.altervista.org/BG/icoLogo.png" sizes="32x32">
        <%- include('./assets/css'); %>
	</head>
	<body class="is-preload">
		<div id="wrapper">
			<div id="bg"></div>
			<div id="overlay"></div>
			<div id="main">
                

				<!-- Header -->
					<header id="header">
                        
                        <img src="https://latitanti.altervista.org/logoBG.png" class="fa-solid fa-play"></img>
							<h1>ButtonGame v.0.4</h1>
                        <h2 class="popupDesk">In questo puzzle dovrete accoppiare i numeri uguali.</h2>
                        
						<p>#nodejs #socket.io &nbsp;&bull;&nbsp;#ejs #express &nbsp;&bull;&nbsp; #Render Web Service</p>
                        <ul class="popupDesk">  
                            <li> bottoni con i numeri uguali avranno anche lo stesso colore </li>
                            <li> Cerca di distruggere tutti i bottoni per ricevere il max punteggio </li>
                        </ul>
						<nav>
							<ul>
							<!--	<li><a href="#" class="fa-solid fa-house"><span class="label">Home</span></a></li>-->
								<li><a href="#" id='play' class="fa-solid fa-play"><span class="label">PlayGame</span></a></li>
								<li><a href="#" id='stats' class="fa-solid fa-star"><span class="label">Stats</span></a></li>
								<li><a href="#" id='conf' class="fa-solid fa-gear"><span class="label">Conf</span></a></li>
                               </ul>
						</nav>
					</header>
                <!-- Info Account -->
                    <section>
                        <div id="infoAccount">
                            <p>USER:</p>
                        </div>
                    </section>
                 

                    <section>
                     <!-- The Modal -->
            <div id="myModal" class="modal">
                     <!-- START Modal content -->
                        <!-- Modal content -->

                        <!--header del modal ..MOdifico ogni volta quando apro un modal-->
                <div id="modal-document" class="modal-content">
                            <div class="modal-header starr">
                                <span class="close">&times;</span>
                                <span id='labelLogo' class="fa-solid fa-gear"></span>
                                <span id="labelPage" class="label"> CONF </span>
                            </div>

                    <!--        PAGINA CONFIGURAZIONE           -->
                    <div id='modal-conf-page' class="modal-body hide">
                        <section class="settings-panel">
                            <div class="panel-intro">
                                <span class="fa-solid fa-sliders"></span>
                                <div>
                                    <h2>Configurazioni</h2>
                                    <p>Personalizza l’esperienza di gioco. Le preferenze restano salvate su questo dispositivo.</p>
                                </div>
                            </div>
                            <label class="setting-row" for="setting-audio">
                                <span><strong>Effetti sonori</strong><small>Suoni per selezioni, errori e combinazioni</small></span>
                                <input type="checkbox" id="setting-audio" checked>
                                <i class="setting-switch" aria-hidden="true"></i>
                            </label>
                            <label class="setting-row" for="setting-effects">
                                <span><strong>Animazioni</strong><small>Ingrandimenti, esplosioni e spostamenti delle tessere</small></span>
                                <input type="checkbox" id="setting-effects" checked>
                                <i class="setting-switch" aria-hidden="true"></i>
                            </label>
                            <div class="settings-status">
                                <span class="fa-solid fa-circle-check"></span>
                                <span id="settings-status-text">Preferenze attive</span>
                            </div>
                        </section>
                    </div> 


    <!--          PAGINA STATS           -->
                    <div id='modal-conf-stat' class="modal-body hide">
                        <section class="leaderboard-panel">
                            <div class="panel-intro">
                                <span class="fa-solid fa-trophy"></span>
                                <div><h2>Classifica</h2><p>I migliori punteggi di tutte le modalità.</p></div>
                            </div>
                            <ol id="statsListEl" class="leaderboard-list"></ol>
                        </section>
                    </div> 


    <!--          PAGINA play         -->
    <div id='modal-conf-game' class="modal-body hide">
        <h2>Play The Game</h2>
        <br>
        <div class="modal-body">
                
        <div onclick="toggleNumberBlastModes(event)" class="contact game-mode-card" id="numberBlastGameCard">
            <img class="pic imgPlaygame" src="https://latitanti.altervista.org/BG/img/png.png" ></img>
            <h2>NUMBER BLAST</h2>
            <p class="mode-hint">Scegli come giocare</p>
            <div id="numberBlastModeSelector" class="mode-selector hide">
                <button type="button" onclick="playStart(1, event)"><span class="fa-solid fa-user"></span> SINGLE PLAYER</button>
                <button type="button" onclick="playStart1vs1(event)"><span class="fa-solid fa-user-group"></span> 1 VS 1</button>
                <div id="waitingplayer" class="waiting-mode hide"><span class="fa-solid fa-hourglass-start"></span> <span id="waitingplayerText"></span></div>
            </div>
        </div>

        <div onclick="playSudoku()" class="contact">
            <div class="pic imgPlaygame sudoku-menu-icon">9</div>
            <h2>SUDOKU</h2>
        </div>

        <div onclick="togglePairsModes(event)" class="contact game-mode-card" id="pairsGameCard">
            <div class="pic imgPlaygame pairs-menu-icon">7·7</div>
            <h2>COPPIE DI NUMERI</h2>
            <p class="mode-hint">Scegli come giocare</p>
            <div id="pairsModeSelector" class="mode-selector hide">
                <button type="button" onclick="playPairs(event)"><span class="fa-solid fa-user"></span> SINGLE PLAYER</button>
                <button type="button" onclick="playPairs1vs1(event)"><span class="fa-solid fa-user-group"></span> 1 VS 1</button>
                <div id="pairsWaitingPlayer" class="waiting-mode hide"><span class="fa-solid fa-hourglass-start"></span> <span id="pairsWaitingText"></span></div>
            </div>
        </div>
        <br>
         </div>
    </div> 


     <!--          PAGINA PLAYGROUND     .gaming-area -->
     <div id='modal-playGround' class="modal-body hide">
        <h2>Giochi Area</h2>
        <div id="gameInfo">
            <h2 id="gameLevel"></h2>
            <div id="gameMission"></div>
            <span id="gameScore">Punteggio livello: 0</span>
            &nbsp;&bull;&nbsp;
            <span id="gameTotalScore">Totale: 0</span>
            &nbsp;&bull;&nbsp;
            <span id="gameRemaining"></span>
            &nbsp;&bull;&nbsp;
            <span id="gameTimer">TEMPO: 00:00.0</span>
            &nbsp;&bull;&nbsp;
            <span id="gameDeadline">LIMITE: --:--.-</span>
            &nbsp;&bull;&nbsp;
            <span id="gameCombo">COMBO: ×1</span>
            &nbsp;&bull;&nbsp;
            <span id="gameErrors">ERRORI: 0</span>
            <div id="gameBonusMsg"></div>
        </div>
        <div id="buttonAreaH">
       
       </div>
    </div> 

                </div>
                    <!-- FINE Modal content -->
            </div> 
                    </section>
				<!-- Footer -->
					<footer id="footer">
                      
						<span class="copyright">&copy;ButtoneGame</span>
					</footer>

			</div>
		</div>
	 <script src="https://kit.fontawesome.com/e4ff14a47e.js" crossorigin="anonymous"></script>
     <%- include('./assets/client-js'); %>    
        <script>
		let user;
            window.onload = function() {
		    document.body.classList.remove('is-preload');
		    user= new Page();
	    }
                  window.ontouchmove = function() { return false; }
                  window.onorientationchange = function() { document.body.scrollTop = 0; }
		
          </script>  
          
          <script src="https://cdn.socket.io/4.7.2/socket.io.min.js" integrity="sha384-mZLF4UVrpi/QTWPA7BjNPEnkIfRFn4ZEO3Qt/HFklTJBj/gBOV8G3HcKn4NfQblz" crossorigin="anonymous"></script>
		<script>
			
            let toggleNumberBlastModes = (event)=>{
            event.stopPropagation();
            const selector = document.getElementById('numberBlastModeSelector');
            const pairsSelector = document.getElementById('pairsModeSelector');
            pairsSelector.classList.add('hide');
            document.getElementById('pairsGameCard').classList.remove('expanded');
            selector.classList.toggle('hide');
            document.getElementById('numberBlastGameCard').classList.toggle('expanded', !selector.classList.contains('hide'));
            }

            let playStart = (liv, event)=>{
            if(event) event.stopPropagation();
            user.socket.emit('game start',liv );// il numero di bottoni aumenta automaticamente col livello
            }

        let playStart1vs1 = (event)=>{
            if(event) event.stopPropagation();
            console.log("invio richiesta al server [ 1 versus 1 ] ")
            user.socket.emit('gameOnline 1vs1','join' );
            document.getElementById('waitingplayer').classList.remove('hide');
            document.getElementById('waitingplayerText').innerText=' Invio richiesta al server...';
            }

        let playSudoku = ()=>{
            user.socket.emit('sudoku start');
        }

        let togglePairsModes = (event)=>{
            event.stopPropagation();
            const selector = document.getElementById('pairsModeSelector');
            const numberBlastSelector = document.getElementById('numberBlastModeSelector');
            numberBlastSelector.classList.add('hide');
            document.getElementById('numberBlastGameCard').classList.remove('expanded');
            selector.classList.toggle('hide');
            document.getElementById('pairsGameCard').classList.toggle('expanded', !selector.classList.contains('hide'));
        }

        let playPairs = (event)=>{
            if(event) event.stopPropagation();
            user.socket.emit('pairs start');
        }

        let playPairs1vs1 = (event)=>{
            if(event) event.stopPropagation();
            user.socket.emit('pairsOnline 1vs1', 'join');
            document.getElementById('pairsWaitingPlayer').classList.remove('hide');
            document.getElementById('pairsWaitingText').innerText = 'Ricerca avversario...';
        }

        </script>
	</body>
</html>
