.buttonGame{
    position: relative;
    overflow: hidden;
    background-color: #1d1;
    /* color: white; */
    border-radius: 8%;
    font-size: 24px;
    height: 60px;
    width: 60px;
    flex: 0 0 60px;
    margin: 0;
    box-shadow: 0px 0px 2px 0px black;
    transition: width 0.2s ease, height 0.2s ease, flex-basis 0.2s ease,
                box-shadow 0.2s ease, filter 0.2s ease, opacity 0.2s ease;
}

.buttonGame.timed-selection::after {
    content: '';
    position: absolute;
    z-index: 5;
    left: 4px;
    right: 4px;
    bottom: 4px;
    height: 5px;
    border-radius: 99px;
    background: #ffe15a;
    box-shadow: 0 0 5px rgba(255,225,90,.9);
    transform-origin: left center;
    animation: selectionCountdown var(--selection-ms, 4000ms) linear forwards;
}

@keyframes selectionCountdown {
    from { transform: scaleX(1); background: #7dff73; }
    65% { background: #ffe15a; }
    to { transform: scaleX(0); background: #ff4f43; }
}

.buttonGame.selection-expired {
    animation: tileTimeout .28s ease;
    box-shadow: 0 0 0 4px #e54b3e, 0 7px 16px rgba(103,18,12,.35);
}

@keyframes tileTimeout {
    25% { transform: translateX(-6px) rotate(-3deg); }
    75% { transform: translateX(6px) rotate(3deg); }
}

