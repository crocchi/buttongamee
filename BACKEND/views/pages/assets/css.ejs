}
div#modal-playGround {
    box-sizing: border-box;
    min-height: 100%;
    padding: 4.8em 1em 2em;
    overflow-y: auto;
    overscroll-behavior: contain;
}
/* Quando parte un gioco il pannello sale dal basso e occupa l'intero schermo. */
#modal-document.game-open {
    inset: 0;
    bottom: auto;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    overflow: hidden;
    animation: gameSlideIn .45s cubic-bezier(.22, .8, .3, 1) both;
    -webkit-animation: gameSlideIn .45s cubic-bezier(.22, .8, .3, 1) both;
}

#modal-document.game-open #modal-playGround {
    height: 100%;
}

@keyframes gameSlideIn {
    from { transform: translateY(100%); opacity: .65; }
    to { transform: translateY(0); opacity: 1; }
}

@-webkit-keyframes gameSlideIn {
    from { -webkit-transform: translateY(100%); opacity: .65; }
    to { -webkit-transform: translateY(0); opacity: 1; }
}
#buttonAreaH {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: flex-start;
    justify-content: center;
    gap: 12px;
    padding: 10px;
    overflow-x: hidden;
    overflow-y: auto;
    max-height: calc(100dvh - 17em);
}

#buttonAreaH.match3-board {
    --board-size: 6;
    display: grid;
    grid-template-columns: repeat(var(--board-size), minmax(42px, 64px));
    justify-content: center;
    align-items: center;
    gap: 7px;
    max-height: 60vh;
    padding: 14px;
    overflow: auto;
    perspective: 700px;
    position: relative;
}

.match3-tile {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    min-width: 0;
    border: 2px solid rgba(255,255,255,0.7);
    border-radius: 20%;
    color: #fff;
    font-size: clamp(18px, 3vw, 28px);
    font-weight: 900;
    text-shadow: 0 2px 2px rgba(0,0,0,0.45);
    box-shadow: inset 0 4px 8px rgba(255,255,255,0.35), 0 4px 8px rgba(0,0,0,0.3);
    transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
}

.match3-tile:hover { transform: translateY(-2px); filter: brightness(1.12); }
.match3-tile.selected {
    transform: scale(1.14);
    box-shadow: 0 0 0 4px #fff, 0 8px 18px rgba(0,0,0,.45);
    z-index: 3;
}
.match3-tile b { position: absolute; right: 4px; bottom: 1px; color: #fff36a; font-size: .65em; }
.match3-tile.special-bomb { border-radius: 50%; animation: specialPulse 1s ease-in-out infinite alternate; }
.match3-tile.tile-1 { background: linear-gradient(145deg,#ff7676,#c52c3c); }
.match3-tile.tile-2 { background: linear-gradient(145deg,#ffbd59,#d57800); }
.match3-tile.tile-3 { background: linear-gradient(145deg,#ffe867,#b7a000); }
.match3-tile.tile-4 { background: linear-gradient(145deg,#6ddc88,#16823b); }
.match3-tile.tile-5 { background: linear-gradient(145deg,#61bfff,#1769a8); }
.match3-tile.tile-6 { background: linear-gradient(145deg,#c184ff,#7134ac); }
.match3-board.resolving .match3-tile { pointer-events: none; }
.match3-board.invalid-move { animation: invalidMove .28s ease; }

.match3-particle {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 10;
    box-shadow: 0 0 7px rgba(255,255,255,.9);
}

@keyframes invalidMove { 25% { transform: translateX(-8px); } 75% { transform: translateX(8px); } }
@keyframes specialPulse { to { box-shadow: 0 0 18px #fff36a, inset 0 0 12px rgba(255,255,255,.7); } }

@media screen and (max-width: 600px) {
    #buttonAreaH.match3-board {
        grid-template-columns: repeat(var(--board-size), minmax(32px, 1fr));
        gap: 4px;
        padding: 8px 2px;
    }
}

.sudoku-menu-icon {
