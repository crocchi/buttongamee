setupSettings(){
    const audio = this.getEl('setting-audio');
    const effects = this.getEl('setting-effects');
    const status = this.getEl('settings-status-text');
    if(!audio || !effects) return;
    audio.checked = localStorage.getItem('buttonGameAudio') !== 'off';
    effects.checked = localStorage.getItem('buttonGameEffects') !== 'off';
    const apply = () => {
        sfx.enabled = audio.checked;
        document.body.classList.toggle('effects-off', !effects.checked);
        localStorage.setItem('buttonGameAudio', audio.checked ? 'on' : 'off');
        localStorage.setItem('buttonGameEffects', effects.checked ? 'on' : 'off');
        status.textContent = `Audio ${audio.checked ? 'attivo' : 'disattivato'} · Animazioni ${effects.checked ? 'attive' : 'disattivate'}`;
    };
    audio.onchange = apply;
    effects.onchange = apply;
    apply();
}

// Get the <span> element that closes the modal



openPag(page){
