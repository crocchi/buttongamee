// ---- LOGICA DI GIOCO ----

bindGameEvents(){
    this.socket.on('gameSet', (payload) => this.onGameSet(payload));
    this.socket.on('gameOverAck', (payload) => this.onGameOverAck(payload));
    this.socket.on('campaignLost', (payload) => this.onCampaignLost(payload));
    this.socket.on('gameResult', (payload) => this.onGameResult(payload));
    this.socket.on('buttonSelected', (payload) => this.onButtonSelected(payload));
    this.socket.on('pairMatched', (payload) => this.onPairMatched(payload));
    this.socket.on('pairMismatch', (payload) => this.onPairMismatch(payload));
    this.socket.on('selectionExpired', (payload) => this.onSelectionExpired(payload));
    this.socket.on('selectionLimit', ({ max }) => this.showBonusMessage(`Puoi aprire al massimo ${max} tessere insieme`));
    this.socket.on('unlockButtons', (payload) => this.onUnlockButtons(payload));
    this.socket.on('nicknameResult', (payload) => this.onNicknameResult(payload));
    this.socket.on('match3State', (payload) => this.onMatch3State(payload));
    this.socket.on('match3Invalid', () => this.onMatch3Invalid());
    this.socket.on('sudokuSet', (payload) => this.setupSudoku(payload));
    this.socket.on('sudokuCell', (payload) => this.onSudokuCell(payload));
    this.socket.on('sudokuComplete', (payload) => this.onSudokuComplete(payload));
    this.socket.on('escapeSet', (payload) => this.setupEscapeMath(payload));
    this.socket.on('escapeState', (payload) => this.setupEscapeMath(payload));
    this.socket.on('escapeVersusUpdate', (payload) => this.onEscapeVersusUpdate(payload));
    this.socket.on('escapeComplete', (payload) => this.onEscapeComplete(payload));
    this.socket.on('pairsComplete', (payload) => this.onPairsComplete(payload));
    this.socket.on('statsData', (rows) => this.renderStats(rows));
    this.socket.on('adventureData', (payload) => this.renderAdventureMap(payload));
    this.socket.on('adventureNodeComplete', (payload) => this.onAdventureNodeComplete(payload));
    this.socket.on('adventureNodeFailed', (payload) => this.onAdventureNodeFailed(payload));
    this.socket.on('adventureError', ({ message }) => {
        alert(message || 'Errore nella Mappa Avventura.');
        this.openAdventure();
    });
}

onGameSet(payload){
    const { mode, puzzle, data, liv, levelComplete, elapsedMs = 0, config = null, lockedIndices = [], adventureNode = null } = payload;

    if(mode === 'match3' || mode === 'match3-1vs1'){
        this.setupMatch3(payload);
        return;
    }

    if(mode === '1vs1-wait' || mode === 'pairs-1vs1-wait' || mode === 'escape-math-1vs1-wait'){
        const isPairsWaiting = mode === 'pairs-1vs1-wait';
        const isEscapeWaiting = mode === 'escape-math-1vs1-wait';
        const waitingBox = isEscapeWaiting ? this.escapeWaitingPlayer : (isPairsWaiting ? this.pairsWaitingPlayer : this.waitingPlayer);
        const waitingText = isEscapeWaiting ? this.escapeWaitingText : (isPairsWaiting ? this.pairsWaitingText : this.waitingPlayerText);
        if(waitingBox && waitingBox.classList.contains('hide')) waitingBox.classList.remove('hide');
        if(waitingText) waitingText.innerText = data;
        [this.waitingPlayer, this.pairsWaitingPlayer, this.escapeWaitingPlayer]
            .filter(box => box && box !== waitingBox).forEach(box => box.classList.add('hide'));
        return;
    }

    this.hideWaitingIndicators();

    if(levelComplete){
        // livello superato: si continua subito col livello successivo, niente ritorno al menu
        this.totalScore = levelComplete.totalScore;
        sfx.levelUp();
        this.showBonusMessage(`LIVELLO ${levelComplete.previousLiv} completato! +${levelComplete.score} punti`);
    } else {
        this.totalScore = 0;
    }

    this.startGame(mode, puzzle, liv, elapsedMs, config, lockedIndices, adventureNode);
}

hideWaitingIndicators(){
    [
        [this.waitingPlayer, this.waitingPlayerText],
        [this.pairsWaitingPlayer, this.pairsWaitingText],
        [this.escapeWaitingPlayer, this.escapeWaitingText],
    ].forEach(([box, text]) => {
        if(box) box.classList.add('hide');
        if(text) text.textContent = '';
    });
}

renderAdventureMap(payload){
    if(!payload || !this.adventureMapEl) return;
    this.adventureData = payload;
    const progressByNode = new Map((payload.progress || []).map(row => [Number(row.node_id), row]));
    const totalStars = Array.from(progressByNode.values()).reduce((sum, row) => sum + Number(row.stars || 0), 0);
    if(this.adventureStarsEl) this.adventureStarsEl.textContent = `${totalStars}/${(payload.nodes || []).length * 3}`;
    this.adventureMapEl.replaceChildren();

    (payload.worlds || []).forEach(world => {
        const section = document.createElement('section');
        section.className = `adventure-world world-${world.theme || world.id}`;
        const header = document.createElement('header');
        header.className = 'adventure-world-header';
        const worldProgress = (payload.nodes || []).filter(node => node.world === world.id && progressByNode.has(node.id)).length;
        header.innerHTML = `<span>MONDO ${world.id}</span><h3></h3><p></p><strong>${worldProgress}/10</strong>`;
        header.querySelector('h3').textContent = world.name;
        header.querySelector('p').textContent = world.description;
        section.appendChild(header);

        const path = document.createElement('div');
        path.className = 'adventure-path';
        (payload.nodes || []).filter(node => node.world === world.id).forEach(node => {
            const result = progressByNode.get(node.id);
            const unlocked = node.id === 1 || progressByNode.has(node.id - 1);
            const item = document.createElement('div');
            item.className = `adventure-node-wrap${node.position % 2 === 0 ? ' path-right' : ' path-left'}`;
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `adventure-node game-${node.game}${result ? ' completed' : ''}${node.boss ? ' boss' : ''}`;
            button.disabled = !unlocked;
            button.setAttribute('aria-label', unlocked ? `Livello ${node.id}: ${node.title}` : `Livello ${node.id} bloccato`);
            const icon = document.createElement('span');
            icon.className = 'adventure-node-icon';
            icon.textContent = unlocked ? node.icon : '🔒';
            const number = document.createElement('strong');
            number.textContent = node.id;
            const stars = document.createElement('small');
            const starCount = Number(result && result.stars || 0);
            stars.textContent = `${'★'.repeat(starCount)}${'☆'.repeat(3 - starCount)}`;
            button.append(icon, number, stars);
            if(unlocked){
                button.onclick = () => {
                    this.currentAdventureNode = node;
                    button.classList.add('launching');
                    this.socket.emit('adventure start', node.id);
                };
            }
            const label = document.createElement('div');
            label.className = 'adventure-node-label';
            label.innerHTML = `<strong></strong><small>${node.boss ? 'BOSS · ' : ''}${node.label}</small>`;
            label.querySelector('strong').textContent = node.title;
            item.append(button, label);
            path.appendChild(item);
        });
        section.appendChild(path);
        this.adventureMapEl.appendChild(section);
    });
}

onAdventureNodeComplete(payload){
    this.stopTimer();
    this.renderAdventureMap(payload);
    this.currentAdventureNode = null;
    sfx.levelUp();
    alert(`Livello ${payload.nodeId} completato! ${'★'.repeat(payload.stars)}${'☆'.repeat(3 - payload.stars)} · ${payload.score} punti`);
    this.openAdventure();
}

onAdventureNodeFailed({ reason }){
    this.stopTimer();
    this.currentAdventureNode = null;
    const messages = { time: 'Tempo scaduto', moves: 'Mosse terminate', timeout: 'Tempo scaduto', lives: 'Vite terminate' };
    alert(`${messages[reason] || 'Sfida non superata'}. Puoi riprovare dalla mappa.`);
    this.openAdventure();
}

// icone dei bonus originali del gioco: Atom the Point (punti extra) e Atom the Bomb (distrugge un'altra coppia)
BONUS_ICON = {
    point: 'https://latitanti.altervista.org/BG/img/atom-the-point.png',
    bomb: 'https://latitanti.altervista.org/BG/img/atom-the-bomb.png',
};

setupMatch3(payload){
    const { board, liv, score = 0, totalScore = 0, movesLeft, definition, elapsedMs = 0, levelComplete, playerScores = {}, adventureNode = null } = payload;
    const multiplayer = payload.mode === 'match3-1vs1';
    this.currentMode = payload.mode;
    this.currentConfig = null;
    this.score = score;
    this.totalScore = totalScore;
    this.match3Selected = null;
    this.match3Busy = false;
    this.startTimer(elapsedMs);
    this.gameLevelEl.textContent = adventureNode
        ? `MAPPA #${adventureNode.id} · ${adventureNode.title}`
        : (multiplayer ? 'NUMBER BLAST · 1 VS 1' : `NUMBER BLAST · LIVELLO ${liv}/10`);
    this.gameMissionEl.textContent = multiplayer
        ? 'Condividete la griglia: conquista più punti in 30 mosse'
        : `Raggiungi ${definition.targetScore} punti in ${definition.moves} mosse`;
    const myScore = playerScores[this.socket.id] || score;
    const opponentScore = Object.entries(playerScores).find(([id]) => id !== this.socket.id)?.[1] || 0;
    this.gameScoreEl.textContent = multiplayer ? `TU: ${myScore}` : `PUNTEGGIO: ${score}/${definition.targetScore}`;
    this.gameTotalScoreEl.textContent = multiplayer ? `AVVERSARIO: ${opponentScore}` : `TOTALE: ${totalScore + score}`;
    this.gameRemainingEl.textContent = `MOSSE: ${movesLeft}`;
    this.gameComboEl.textContent = 'MATCH: 3+';
    this.gameErrorsEl.textContent = 'SPECIALI: 4/5';
    if(levelComplete){
        sfx.levelUp();
        this.showBonusMessage(`Livello ${levelComplete.previousLiv} completato! +${levelComplete.score}`);
    }
    this.renderMatch3Board(board);
    this.openPag('gameArea');
}

renderMatch3Board(board){
    this.buttonArea.className = 'match3-board';
    this.buttonArea.style.setProperty('--board-size', board.length);
    this.buttonArea.replaceChildren();
    board.forEach((line, row) => line.forEach((cell, col) => {
        const tile = document.createElement('button');
        tile.className = `match3-tile tile-${cell.value}${cell.special ? ` special-${cell.special}` : ''}`;
        tile.dataset.row = row;
        tile.dataset.col = col;
        tile.setAttribute('aria-label', `Numero ${cell.value}${cell.special ? ` speciale ${cell.special}` : ''}`);
        const number = document.createElement('span');
        number.textContent = cell.value;
        tile.appendChild(number);
        if(cell.special){
            const badge = document.createElement('b');
            badge.textContent = cell.special === 'row' ? '↔' : (cell.special === 'col' ? '↕' : '✦');
            tile.appendChild(badge);
        }
        tile.onclick = () => this.selectMatch3Tile(tile);
        this.buttonArea.appendChild(tile);
    }));
}

selectMatch3Tile(tile){
    if(this.match3Busy) return;
    const position = { row: Number(tile.dataset.row), col: Number(tile.dataset.col) };
    if(!this.match3Selected){
        this.match3Selected = position;
        tile.classList.add('selected');
        tile.animate([
            { transform: 'scale(1)', offset: 0 },
            { transform: 'scale(.9)', offset: .25 },
            { transform: 'scale(1.16)', offset: .7 },
            { transform: 'scale(1.14)', offset: 1 },
        ], { duration: 260, easing: 'cubic-bezier(.2,.9,.25,1)' });
        return;
    }
    const previous = this.match3Selected;
    const distance = Math.abs(previous.row - position.row) + Math.abs(previous.col - position.col);
    this.buttonArea.querySelector('.match3-tile.selected')?.classList.remove('selected');
    if(distance !== 1){
        this.match3Selected = position;
        tile.classList.add('selected');
        tile.animate([{ transform: 'scale(.9)' }, { transform: 'scale(1.14)' }], {
            duration: 180, easing: 'cubic-bezier(.2,.9,.25,1)'
        });
        return;
    }
    const previousTile = this.buttonArea.querySelector(
        `.match3-tile[data-row="${previous.row}"][data-col="${previous.col}"]`
    );
    const firstRect = previousTile.getBoundingClientRect();
    const secondRect = tile.getBoundingClientRect();
    const dx = secondRect.left - firstRect.left;
    const dy = secondRect.top - firstRect.top;
    this.match3SwapAnimations = [
        previousTile.animate([
            { transform: 'translate(0,0) scale(1.14)', zIndex: 4 },
            { transform: `translate(${dx * .5}px, ${dy * .5 - 8}px) scale(1.08)`, zIndex: 4, offset: .5 },
            { transform: `translate(${dx}px, ${dy}px) scale(1)`, zIndex: 4 },
        ], { duration: 240, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'forwards' }),
        tile.animate([
            { transform: 'translate(0,0)', zIndex: 3 },
            { transform: `translate(${-dx * .5}px, ${-dy * .5 + 8}px) scale(.96)`, zIndex: 3, offset: .5 },
            { transform: `translate(${-dx}px, ${-dy}px)`, zIndex: 3 },
        ], { duration: 240, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'forwards' }),
    ];
    this.match3SwapPromise = Promise.all(this.match3SwapAnimations.map(animation => animation.finished.catch(() => {})));
    this.match3PendingMove = { previous, position };
    this.match3Selected = null;
    this.match3Busy = true;
    this.buttonArea.classList.add('resolving');
    this.socket.emit('match3 move', { from: previous, to: position });
}

async onMatch3State(payload){
    if(payload.mode === 'match3-1vs1'){
        const myScore = payload.playerScores[this.socket.id] || 0;
        const opponentScore = Object.entries(payload.playerScores).find(([id]) => id !== this.socket.id)?.[1] || 0;
        this.gameScoreEl.textContent = `TU: ${myScore}`;
        this.gameTotalScoreEl.textContent = `AVVERSARIO: ${opponentScore}`;
        this.showBonusMessage(payload.by === this.socket.id ? `+${payload.gained} punti` : `Avversario +${payload.gained}`);
    } else {
        this.score = payload.score;
        this.totalScore = payload.totalScore;
        this.gameScoreEl.textContent = `PUNTEGGIO: ${payload.score}/${payload.definition.targetScore}`;
        this.gameTotalScoreEl.textContent = `TOTALE: ${payload.totalScore + payload.score}`;
    }
    this.gameRemainingEl.textContent = `MOSSE: ${payload.movesLeft}`;
    if(payload.mode !== 'match3-1vs1'){
        if(payload.steps && payload.steps.length > 1) this.showBonusMessage(`CASCATA ×${payload.steps.length}! +${payload.gained}`);
        else this.showBonusMessage(`+${payload.gained} punti`);
    }
    await this.match3SwapPromise;
    this.match3SwapAnimations.forEach(animation => animation.cancel());
    for(const step of (payload.steps || [])){
        this.renderMatch3Board(step.before);
        await this.animateMatch3Clear(step);
        this.renderMatch3Board(step.after);
        await this.animateMatch3Fall(step.cascade);
        if(step.cascade > 1) sfx.levelUp(); else sfx.match();
    }
    this.renderMatch3Board(payload.board);
    this.match3Busy = false;
    this.match3PendingMove = null;
}

async onMatch3Invalid(){
    await this.match3SwapPromise;
    this.match3SwapAnimations.forEach(animation => animation.cancel());
    this.buttonArea.classList.add('invalid-move');
    const move = this.match3PendingMove;
    if(move){
        [move.previous, move.position].forEach(position => {
            const target = this.buttonArea.querySelector(`.match3-tile[data-row="${position.row}"][data-col="${position.col}"]`);
            target?.animate([
                { transform: 'translateX(0)', filter: 'brightness(1)' },
                { transform: 'translateX(-7px)', filter: 'brightness(1.6)' },
                { transform: 'translateX(7px)' },
                { transform: 'translateX(0)', filter: 'brightness(1)' },
            ], { duration: 280, easing: 'ease-out' });
        });
    }
    sfx.wrong();
    setTimeout(() => {
        this.buttonArea.classList.remove('invalid-move', 'resolving');
        this.match3Busy = false;
        this.match3PendingMove = null;
    }, 280);
}

async animateMatch3Clear(step){
    const animations = [];
    step.cleared.forEach(item => {
        const [row, col] = item.split(':').map(Number);
        const tile = this.buttonArea.querySelector(`.match3-tile[data-row="${row}"][data-col="${col}"]`);
        if(!tile) return;
        this.spawnMatch3Particles(tile, step.cascade);
        animations.push(tile.animate([
            { transform: 'scale(1) rotate(0)', opacity: 1, filter: 'brightness(1)' },
            { transform: 'scale(1.32) rotate(-5deg)', opacity: 1, filter: 'brightness(2.3)', offset: .45 },
            { transform: 'scale(0) rotate(18deg)', opacity: 0, filter: 'brightness(2.8)' },
        ], { duration: 300, easing: 'cubic-bezier(.3,.8,.3,1)', fill: 'forwards' }));
    });
    await Promise.all(animations.map(animation => animation.finished.catch(() => {})));
}

async animateMatch3Fall(cascade){
    const animations = Array.from(this.buttonArea.querySelectorAll('.match3-tile')).map(tile => {
        const row = Number(tile.dataset.row);
        return tile.animate([
            { transform: `translateY(${-35 - row * 3}px) scale(.92)`, opacity: .35 },
            { transform: 'translateY(5px) scale(1.03)', opacity: 1, offset: .78 },
            { transform: 'translateY(0) scale(1)', opacity: 1 },
        ], {
            duration: 260 + Math.min(cascade, 4) * 35,
            delay: row * 13,
            easing: 'cubic-bezier(.2,.75,.25,1)',
        });
    });
    await Promise.all(animations.map(animation => animation.finished.catch(() => {})));
}

spawnMatch3Particles(tile, cascade){
    const boardRect = this.buttonArea.getBoundingClientRect();
    const rect = tile.getBoundingClientRect();
    for(let i = 0; i < 7; i++){
        const particle = document.createElement('i');
        particle.className = 'match3-particle';
        particle.style.left = `${rect.left - boardRect.left + rect.width / 2}px`;
        particle.style.top = `${rect.top - boardRect.top + rect.height / 2}px`;
        particle.style.background = getComputedStyle(tile).backgroundColor;
        this.buttonArea.appendChild(particle);
        const angle = (Math.PI * 2 * i / 7) + Math.random() * .35;
        const distance = 24 + Math.random() * 25 + cascade * 3;
        const animation = particle.animate([
            { transform: 'translate(-50%,-50%) scale(1)', opacity: 1 },
            { transform: `translate(calc(-50% + ${Math.cos(angle) * distance}px), calc(-50% + ${Math.sin(angle) * distance}px)) scale(0)`, opacity: 0 },
        ], { duration: 380 + Math.random() * 180, easing: 'cubic-bezier(.15,.7,.3,1)' });
        animation.finished.finally(() => particle.remove());
    }
}

setupSudoku({
    board, fixed, errors = 0, elapsedMs = 0, adventureNode = null,
    level = 1, definition = null, totalScore = 0, levelComplete = null,
}){
    definition = definition || { size: board.length, maxValue: 9, boxRows: 3, boxCols: 3, label: 'Sudoku' };
    this.currentMode = 'sudoku';
    this.currentConfig = null;
    this.errors = errors;
    this.sudokuSelected = null;
    this.startTimer(elapsedMs);
    this.gameLevelEl.textContent = adventureNode
        ? `MAPPA #${adventureNode.id} · ${adventureNode.title}`
        : `SUDOKU · LIVELLO ${level}/10${level === 10 ? ' · BOSS' : ''}`;
    this.gameMissionEl.textContent = definition.size === 3
        ? 'Completa il quadrato usando una sola volta tutti i numeri da 1 a 9'
        : `Completa righe, colonne e riquadri ${definition.boxRows}×${definition.boxCols} con i numeri da 1 a ${definition.maxValue}`;
    this.gameScoreEl.textContent = `DIFFICOLTÀ: ${definition.label.toUpperCase()}`;
    this.gameTotalScoreEl.textContent = adventureNode ? '' : `TOTALE: ${totalScore}`;
    this.gameRemainingEl.textContent = `ERRORI: ${errors}`;
    this.gameComboEl.textContent = '';
    this.gameErrorsEl.textContent = '';
    this.buttonArea.className = 'sudoku-wrapper';
    this.buttonArea.replaceChildren();

    const grid = document.createElement('div');
    grid.className = 'sudoku-grid';
    grid.style.setProperty('--sudoku-size', definition.size);
    grid.style.setProperty('--sudoku-cell-max', definition.size <= 3 ? '82px' : (definition.size <= 4 ? '70px' : (definition.size <= 6 ? '58px' : '50px')));
    board.forEach((line, row) => line.forEach((value, col) => {
        const cell = document.createElement('button');
        cell.className = 'sudoku-cell' + (fixed[row][col] ? ' fixed' : ' empty');
        if((col + 1) % definition.boxCols === 0 && col < definition.size - 1) cell.classList.add('box-right');
        if((row + 1) % definition.boxRows === 0 && row < definition.size - 1) cell.classList.add('box-bottom');
        cell.dataset.row = row;
        cell.dataset.col = col;
        cell.textContent = value || '';
        cell.disabled = fixed[row][col];
        cell.onclick = () => {
            grid.querySelector('.selected')?.classList.remove('selected');
            this.sudokuSelected = { row, col, cell };
            cell.classList.add('selected');
            cell.animate([{ transform: 'scale(.9)' }, { transform: 'scale(1.08)' }], { duration: 180 });
        };
        grid.appendChild(cell);
    }));

    const pad = document.createElement('div');
    pad.className = 'sudoku-pad';
    pad.style.setProperty('--sudoku-values', definition.maxValue);
    for(let value = 1; value <= definition.maxValue; value++){
        const button = document.createElement('button');
        button.textContent = value;
        button.onclick = () => {
            if(!this.sudokuSelected) return;
            const { row, col } = this.sudokuSelected;
            this.socket.emit('sudoku input', { row, col, value });
        };
        pad.appendChild(button);
    }
    this.buttonArea.append(grid, pad);
    this.openPag('gameArea');
    if(levelComplete){
        sfx.levelUp();
        this.showBonusMessage(`Livello ${levelComplete.level} completato! +${levelComplete.score} punti`);
    }
}

onSudokuCell({ row, col, value, correct, errors }){
    const cell = this.buttonArea.querySelector(`.sudoku-cell[data-row="${row}"][data-col="${col}"]`);
    if(!cell) return;
    if(correct){
        cell.textContent = value;
        cell.classList.remove('selected', 'empty', 'wrong');
        cell.classList.add('solved');
        cell.disabled = true;
        this.sudokuSelected = null;
        sfx.match();
        cell.animate([{ transform: 'scale(1.2)', filter: 'brightness(1.8)' }, { transform: 'scale(1)', filter: 'brightness(1)' }], { duration: 260 });
    } else {
        this.errors = errors;
        this.gameRemainingEl.textContent = `ERRORI: ${errors}`;
        sfx.wrong();
        cell.classList.add('wrong');
        cell.animate([
            { transform: 'translateX(0)' }, { transform: 'translateX(-7px)' },
            { transform: 'translateX(7px)' }, { transform: 'translateX(0)' },
        ], { duration: 280 });
        setTimeout(() => cell.classList.remove('wrong'), 300);
    }
}

onSudokuComplete({ score, elapsedMs, errors, level = 10 }){
    this.stopTimer();
    this.startTime = Date.now() - elapsedMs;
    this.renderTimer();
    alert(`Campagna Sudoku completata fino al livello ${level}! Punteggio: ${score} · Errori: ${errors}`);
    this.openPag('game');
    this.requestPlayerName();
}

setupEscapeMath(payload){
    const {
        level, score = 0, lives = 3, prompt, choices = [], hint, type,
        boss = false, timeLimitMs = 30000, puzzleId, elapsedMs = 0,
        correct, message, gained, mode = 'escape-math', roundsTotal = 100,
        playerScores = {}, playerProgress = {}, opponentLives = 3, adventureNode = null,
    } = payload;
    const multiplayer = mode === 'escape-math-1vs1';
    this.hideWaitingIndicators();
    this.currentMode = mode;
    this.currentConfig = null;
    this.escapePuzzleId = puzzleId;
    this.escapeDeadlineAt = Date.now() + timeLimitMs;
    this.startTimer(elapsedMs);
    const opponentId = Object.keys(playerScores).find(id => id !== this.socket.id);
    const myScore = playerScores[this.socket.id] ?? score;
    const rivalScore = opponentId ? (playerScores[opponentId] || 0) : 0;
    const myProgress = playerProgress[this.socket.id] || Math.max(0, level - 1);
    const rivalProgress = opponentId ? (playerProgress[opponentId] || 0) : 0;
    this.gameLevelEl.textContent = adventureNode
        ? `MAPPA #${adventureNode.id} · ${adventureNode.title}`
        : (multiplayer
        ? `ESCAPE MATH · 1 VS 1 · PORTA ${level}/${roundsTotal}`
        : `ESCAPE MATH · STANZA ${level}/100${boss ? ' · BOSS' : ''}`);
    this.gameMissionEl.textContent = multiplayer
        ? 'Stessi enigmi: apri per primo tutte le 10 porte'
        : 'Scegli la risposta corretta prima che la porta si blocchi';
    this.gameScoreEl.textContent = multiplayer ? `TU: ${myScore}` : `PUNTEGGIO: ${score}`;
    this.gameTotalScoreEl.textContent = multiplayer ? `AVVERSARIO: ${rivalScore}` : (gained ? `ULTIMA PORTA: +${gained}` : '');
    this.gameRemainingEl.textContent = multiplayer
        ? `VITE TU: ${lives} · RIVALE: ${opponentLives}`
        : `VITE: ${'♥'.repeat(lives)}${'♡'.repeat(Math.max(0, 3 - lives))}`;
    this.gameComboEl.textContent = multiplayer ? `PORTE: ${myProgress}–${rivalProgress}` : (boss ? 'STANZA BOSS' : `PORTA ${level}`);
    this.gameErrorsEl.textContent = '';
    this.buttonArea.className = `escape-room-wrapper${correct === true ? ' room-correct' : (correct === false ? ' room-wrong' : '')}`;
    this.buttonArea.replaceChildren();

    const scene = document.createElement('section');
    scene.className = 'escape-scene';
    const door = document.createElement('div');
    door.className = `escape-door${boss ? ' boss-door' : ''}`;
    door.innerHTML = '<span class="door-lock">∑</span><i class="door-light"></i>';

    const puzzle = document.createElement('div');
    puzzle.className = 'escape-puzzle-card';
    const labels = {
        'add-sub': 'OPERAZIONE', 'mult-div': 'CALCOLO', sequence: 'SEQUENZA',
        target: 'NUMERO OBIETTIVO', expression: 'ESPRESSIONE',
    };
    const typeLabel = document.createElement('small');
    typeLabel.textContent = labels[type] || 'ENIGMA';
    const question = document.createElement('div');
    question.className = 'escape-question';
    question.textContent = prompt;
    const hintEl = document.createElement('p');
    hintEl.className = 'escape-hint';
    hintEl.textContent = `INDIZIO: ${hint}`;
    const answerArea = document.createElement('div');
    answerArea.className = 'escape-answers';
    choices.forEach(value => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'escape-answer';
        button.textContent = value;
        button.dataset.answer = value;
        button.onclick = () => {
            answerArea.querySelectorAll('button').forEach(choice => { choice.disabled = true; });
            button.classList.add('chosen');
            this.socket.emit('escape answer', { answer: value, puzzleId: this.escapePuzzleId });
        };
        answerArea.appendChild(button);
    });
    puzzle.append(typeLabel, question, hintEl, answerArea);
    scene.append(door, puzzle);
    this.buttonArea.appendChild(scene);
    this.openPag('gameArea');

    if(correct === true){ sfx.levelUp(); this.showBonusMessage(message || 'Porta aperta!'); }
    if(correct === false){ sfx.wrong(); this.showBonusMessage(message || 'Risposta errata'); }
}

onEscapeVersusUpdate({ playerScores = {}, playerProgress = {}, playerLives = {}, roundsTotal = 10, by, correct, gained }){
    if(this.currentMode !== 'escape-math-1vs1') return;
    const opponentId = Object.keys(playerScores).find(id => id !== this.socket.id);
    const myScore = playerScores[this.socket.id] || 0;
    const opponentScore = opponentId ? (playerScores[opponentId] || 0) : 0;
    const myProgress = playerProgress[this.socket.id] || 0;
    const opponentProgress = opponentId ? (playerProgress[opponentId] || 0) : 0;
    this.gameScoreEl.textContent = `TU: ${myScore}`;
    this.gameTotalScoreEl.textContent = `AVVERSARIO: ${opponentScore}`;
    this.gameRemainingEl.textContent = `VITE TU: ${playerLives[this.socket.id] ?? 3} · RIVALE: ${opponentId ? (playerLives[opponentId] ?? 3) : 3}`;
    this.gameComboEl.textContent = `PORTE: ${myProgress}–${opponentProgress} / ${roundsTotal}`;
    if(by !== this.socket.id){
        if(correct) this.showBonusMessage(`L'avversario ha aperto una porta${gained ? ` (+${gained})` : ''}`);
        else if(correct === false) this.showBonusMessage("L'avversario ha perso una vita");
    }
}

onEscapeComplete({ win, reason, score, level, elapsedMs }){
    this.stopTimer();
    this.startTime = Date.now() - elapsedMs;
    this.renderTimer();
    const message = win
        ? `Sei fuggito da tutte le 100 stanze! Punteggio: ${score}`
        : `${reason === 'timeout' ? 'Tempo scaduto' : 'Vite terminate'} alla stanza ${level}. Punteggio: ${score}`;
    alert(message);
    this.openPag('game');
    this.requestPlayerName();
}

onPairsComplete({ score, elapsedMs, errors }){
    this.stopTimer();
    this.startTime = Date.now() - elapsedMs;
    this.renderTimer();
    alert(`Tutte le coppie trovate! Punteggio: ${score} · Errori: ${errors}`);
    this.openPag('game');
    this.requestPlayerName();
}

startGame(mode, puzzle, liv, elapsedMs = 0, config = null, lockedIndices = [], adventureNode = null){
    this.currentMode = mode;
    this.currentConfig = config;
    this.score = 0;
    this.selectedButton = null;
    this.remainingPairs = mode === 'campain' && config && config.matchRule === 'equal'
        ? new Set(puzzle.map(String)).size
        : Math.floor(puzzle.length / 2);
    this.my1v1Score = 0;
    this.opp1v1Score = 0;
    this.errors = 0;
    this.combo = 0;
    clearTimeout(this.concealTimeout);
    this.levelStartTime = Date.now();
    this.startTimer(elapsedMs);
    this.buttonArea.className = '';
    if(mode === 'pairs-1vs1') this.buttonArea.classList.add('pairs-marathon');
    if(mode === 'campain' && puzzle.length > 80) this.buttonArea.classList.add('large-pairs-board');
    this.buttonArea.style.removeProperty('--board-size');
    this.buttonArea.innerHTML = '';
    this.gameLevelEl.innerText = adventureNode
        ? `MAPPA #${adventureNode.id} · ${adventureNode.title}`
        : (mode === 'pairs'
        ? 'COPPIE DI NUMERI · SINGLE PLAYER'
        : (mode === 'pairs-1vs1'
            ? 'COPPIE DI NUMERI · 1 VS 1'
            : `COPPIE DI NUMERI · MONDO ${config ? config.world : 1} · LIVELLO ${liv || 1}/100${config && config.boss ? ' · BOSS' : ''}`));
    this.renderMission();
    this.updateScoreboard();

    puzzle.forEach((value, index) => {
        const btn = document.createElement('button');
        const isBonus = value === 'bomb' || value === 'point';
        btn.className = 'buttonGame effettoCiakka' + (isBonus ? ` bonus bonus-${value}` : '');
        btn.dataset.value = value;
        btn.dataset.index = index;

        if(isBonus){
            const img = document.createElement('img');
            img.src = this.BONUS_ICON[value];
            img.className = 'bonusImg';
            btn.appendChild(img);
        } else {
            // bottoni con lo stesso numero hanno lo stesso colore
            btn.style.backgroundColor = config && config.noColor
                ? '#45515c'
                : `hsl(${(value * 47) % 360}, 65%, 45%)`;
            const numero = document.createElement('span');
            numero.className = 'numero';
            numero.innerText = value;
            btn.appendChild(numero);
        }

        btn.onclick = () => this.onButtonClick(btn);
        if(config && index < config.exposedCount) btn.classList.add('always-visible');
        if(lockedIndices.includes(index)){
            btn.disabled = true;
            btn.classList.add('level-locked');
        }
        this.buttonArea.appendChild(btn);
    });

    this.openPag('gameArea');

    if(config && config.hidden){
        this.buttonArea.classList.add('previewing');
        this.concealTimeout = setTimeout(() => {
            this.buttonArea.classList.remove('previewing');
            this.buttonArea.querySelectorAll('.buttonGame:not(.always-visible)').forEach(button => button.classList.add('concealed'));
        }, config.previewMs);
    } else {
        this.buttonArea.classList.remove('previewing');
    }
}

renderMission(){
    if(!this.gameMissionEl) return;
    if(this.currentMode === 'pairs'){
        this.gameMissionEl.textContent = 'Trova tutte le coppie uguali nel minor tempo possibile';
        return;
    }
    if(this.currentMode === 'pairs-1vs1'){
        this.gameMissionEl.textContent = '100 coppie condivise: trova più abbinamenti e totalizza più punti del tuo avversario';
        return;
    }
    const config = this.currentConfig || {};
    const rules = [config.matchRule === 'sum10' ? 'Abbina numeri con somma 10' : 'Trova coppie o tris di numeri uguali'];
    if(config.selectionMs) rules.push(`fino a ${config.maxSelections || 4} tessere aperte per ${(config.selectionMs / 1000).toFixed(2)}s`);
    if(config.hidden) rules.push(`memorizza in ${(config.previewMs / 1000).toFixed(1)}s`);
    if(config.exposedCount) rules.push(`${config.exposedCount} tessere restano scoperte`);
    if(config.targetMs) rules.push(`tempo massimo ${Math.round(config.targetMs / 1000)}s`);
    if(config.penaltyMs) rules.push(`errore +${config.penaltyMs / 1000}s`);
    if(config.combo) rules.push('combo attiva');
    if(config.lockedCount) rules.push('2 caselle si aprono dopo 2 coppie');
    if(config.shuffleOnMismatch) rules.push('errore mescola la griglia');
    this.gameMissionEl.textContent = rules.join(' · ');
}

onUnlockButtons({ indices }){
    indices.forEach(index => {
        const button = this.getGameButton(index);
        if(!button) return;
        button.disabled = false;
        button.classList.remove('level-locked');
        if(this.currentConfig && this.currentConfig.hidden) button.classList.add('concealed');
    });
    this.showBonusMessage('Caselle sbloccate!');
}

getGameButton(index){
    return this.buttonArea.querySelector(`.buttonGame[data-index="${index}"]`);
}

onButtonClick(btn){
    this.onButtonClick1vs1(btn);
}

// modalità 1vs1: il click viene solo inoltrato al server, che tiene il tabellone condiviso
// e decide se il bottone è selezionabile (non lo è se già preso dall'avversario)
onButtonClick1vs1(btn){
    if(btn.disabled) return;
    this.socket.emit('game click', { index: Number(btn.dataset.index) });
}

// un giocatore (io o l'avversario) ha selezionato un bottone: lo blocco per entrambi finché non si risolve
onButtonSelected({ index, by, expiresInMs = 0 }){
    const btn = this.getGameButton(index);
    if(!btn) return;
    btn.disabled = true;
    btn.classList.remove('concealed');
    btn.classList.add(by === this.socket.id ? 'selected' : 'locked');
    if(expiresInMs){
        btn.style.setProperty('--selection-ms', `${expiresInMs}ms`);
        btn.classList.remove('timed-selection');
        void btn.offsetWidth;
        btn.classList.add('timed-selection');
    }
}

onPairMatched({ indices, extraIndices, by, bonus, points, combo = 0, multiplier = 1, removedGroups }){
    sfx.match();
    if(bonus === 'point') sfx.point();
    if(bonus === 'bomb') sfx.bomb();

    const buttons = [...indices, ...(extraIndices || [])]
        .map(i => this.getGameButton(i))
        .filter(Boolean);
    buttons.forEach(b => { b.disabled = true; b.classList.remove('selected', 'locked', 'concealed', 'timed-selection'); });
    this.popButtons(...buttons);

    if(bonus === 'point') this.showBonusMessage('Atom the Point: +50 punti extra!');
    if(bonus === 'bomb') this.showBonusMessage('Atom the Bomb: distrutta un\'altra coppia!');
    if(indices.length === 3) this.showBonusMessage(`TRIS! +${points} punti`);

    if(this.currentMode === 'pairs-1vs1'){
        if(by === this.socket.id){ this.my1v1Score += points; } else { this.opp1v1Score += points; }
        this.remainingPairs -= (indices.length + (extraIndices || []).length) / 2;
    } else {
        this.score += points;
        this.remainingPairs -= removedGroups || 1;
        this.combo = combo;
        if(multiplier > 1) this.showBonusMessage(`COMBO ×${multiplier}: +${points} punti!`);
    }
    this.updateScoreboard();
}

onSelectionExpired({ index, penaltyMs = 0, errors, shuffle = false }){
    const btn = this.getGameButton(index);
    if(!btn) return;
    sfx.wrong();
    this.combo = 0;
    this.errors = errors || this.errors + 1;
    if(penaltyMs){
        this.startTime -= penaltyMs;
        this.levelStartTime -= penaltyMs;
        this.showBonusMessage(`Tempo tessera scaduto: +${penaltyMs / 1000} secondi`);
    }
    this.updateScoreboard();
    btn.classList.remove('timed-selection', 'selected', 'locked');
    btn.classList.add('selection-expired');
    setTimeout(() => {
        btn.classList.remove('selection-expired');
        if(this.currentConfig && this.currentConfig.hidden) btn.classList.add('concealed');
        btn.disabled = false;
    }, 280);
    if(shuffle) setTimeout(() => this.shuffleVisibleButtons(), 300);
}

onPairMismatch({ indices, penaltyMs = 0, errors, shuffle = false }){
    sfx.wrong();
    if(this.currentMode !== 'pairs-1vs1'){
        this.combo = 0;
        this.errors = errors || this.errors + 1;
        if(penaltyMs){
            this.startTime -= penaltyMs;
            this.levelStartTime -= penaltyMs;
            this.showBonusMessage(`Errore: +${penaltyMs / 1000} secondi`);
        }
        this.updateScoreboard();
    }
    indices.forEach(i => {
        const btn = this.getGameButton(i);
        if(!btn) return;
        btn.classList.remove('concealed');
        btn.classList.add('wrong');
        setTimeout(() => {
            btn.classList.remove('wrong', 'selected', 'locked');
            if(this.currentConfig && this.currentConfig.hidden) btn.classList.add('concealed');
            btn.disabled = false;
        }, 400);
    });
    if(shuffle) setTimeout(() => this.shuffleVisibleButtons(), 450);
}

shuffleVisibleButtons(){
    const buttons = Array.from(this.buttonArea.querySelectorAll('.buttonGame'));
    for(let i = buttons.length - 1; i > 0; i--){
        const j = Math.floor(Math.random() * (i + 1));
        [buttons[i], buttons[j]] = [buttons[j], buttons[i]];
    }
    buttons.forEach(button => this.buttonArea.appendChild(button));
}

// effetto grafico di "esplosione" quando una coppia viene accoppiata: i bottoni si ingrandiscono,
// svaniscono e vengono rimossi dalla griglia, che si richiude "a calamita" attorno al vuoto rimasto
popButtons(...buttons){
    buttons.forEach(b => b.classList.add('popping'));
    setTimeout(() => {
        this.animateReflow(() => buttons.forEach(b => b.remove()));
    }, 450);
}

// tecnica FLIP: misura le posizioni prima/dopo la rimozione e anima la differenza,
// così i bottoni rimasti "scivolano" verso il vuoto come attratti da una calamita
animateReflow(removeFn){
    const before = new Map();
    this.buttonArea.querySelectorAll('.buttonGame').forEach(b => before.set(b, b.getBoundingClientRect()));

    removeFn();

    this.buttonArea.querySelectorAll('.buttonGame').forEach(b => {
        const prev = before.get(b);
        if(!prev) return;
        const next = b.getBoundingClientRect();
        const dx = prev.left - next.left;
        const dy = prev.top - next.top;
        if(!dx && !dy) return;

        b.style.transition = 'none';
        b.style.transform = `translate(${dx}px, ${dy}px)`;
        requestAnimationFrame(() => {
            b.style.transition = 'transform 0.35s ease';
            b.style.transform = '';
        });
    });
}

showBonusMessage(text){
    if(!this.gameBonusMsgEl) return;
    this.gameBonusMsgEl.innerText = text;
    clearTimeout(this.bonusMsgTimeout);
    this.bonusMsgTimeout = setTimeout(() => { this.gameBonusMsgEl.innerText = ''; }, 2000);
}

updateScoreboard(){
    if(this.currentMode === 'pairs-1vs1'){
        this.gameScoreEl.innerText = `Tu: ${this.my1v1Score}`;
        this.gameTotalScoreEl.innerText = `Avversario: ${this.opp1v1Score}`;
        this.gameRemainingEl.innerText = `COPPIE RIMASTE: ${this.remainingPairs}`;
        this.gameComboEl.innerText = '';
        this.gameErrorsEl.innerText = '';
        return;
    }

    if(this.currentMode === 'pairs'){
        this.gameScoreEl.innerText = `PUNTEGGIO: ${this.score}`;
        this.gameTotalScoreEl.innerText = '';
        this.gameRemainingEl.innerText = `COPPIE RIMASTE: ${this.remainingPairs}`;
        this.gameComboEl.innerText = '';
        this.gameErrorsEl.innerText = `ERRORI: ${this.errors}`;
        return;
    }

    this.gameScoreEl.innerText = `Punteggio livello: ${this.score}`;
    this.gameTotalScoreEl.innerText = `Totale: ${this.totalScore + this.score}`;
    this.gameRemainingEl.innerText = `GRUPPI RIMASTI: ${Math.max(0, this.remainingPairs)}`;
    this.gameComboEl.innerText = this.currentConfig && this.currentConfig.combo
        ? `COMBO: ×${Math.max(1, Math.min(this.combo, 5))}`
        : 'COMBO: —';
    this.gameErrorsEl.innerText = `ERRORI: ${this.errors}`;
}

startTimer(elapsedMs = 0){
    this.stopTimer();
    this.startTime = Date.now() - Math.max(0, Number(elapsedMs) || 0);
    this.renderTimer();
    this.timerInterval = setInterval(() => this.renderTimer(), 100);
}

stopTimer(){
    if(this.timerInterval){
        clearInterval(this.timerInterval);
        this.timerInterval = null;
    }
}

renderTimer(){
    if(!this.gameTimerEl) return;
    const elapsedMs = Math.max(0, Date.now() - this.startTime);
    const minutes = Math.floor(elapsedMs / 60000);
    const seconds = Math.floor((elapsedMs % 60000) / 1000);
    const tenths = Math.floor((elapsedMs % 1000) / 100);
    this.gameTimerEl.textContent = `TEMPO: ${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}.${tenths}`;
    this.gameTimerEl.classList.toggle('warning', elapsedMs >= 60000 && elapsedMs < 120000);
    this.gameTimerEl.classList.toggle('danger', elapsedMs >= 120000);

    if(this.gameDeadlineEl){
        if(this.currentMode === 'campain' && this.currentConfig && this.currentConfig.targetMs){
            const remainingMs = Math.max(0, this.currentConfig.targetMs - (Date.now() - this.levelStartTime));
            const remainingMinutes = Math.floor(remainingMs / 60000);
            const remainingSeconds = Math.floor((remainingMs % 60000) / 1000);
            const remainingTenths = Math.floor((remainingMs % 1000) / 100);
            this.gameDeadlineEl.textContent = `LIMITE: ${String(remainingMinutes).padStart(2, '0')}:${String(remainingSeconds).padStart(2, '0')}.${remainingTenths}`;
            this.gameDeadlineEl.classList.toggle('danger', remainingMs <= 10000);
        } else if(this.currentMode === 'escape-math' || this.currentMode === 'escape-math-1vs1') {
            const remainingMs = Math.max(0, this.escapeDeadlineAt - Date.now());
            const remainingSeconds = Math.floor(remainingMs / 1000);
            const remainingTenths = Math.floor((remainingMs % 1000) / 100);
            this.gameDeadlineEl.textContent = `PORTA: ${remainingSeconds}.${remainingTenths}s`;
            this.gameDeadlineEl.classList.toggle('danger', remainingMs <= 5000);
        } else if(this.currentMode === 'match3' || this.currentMode === 'match3-1vs1') {
            this.gameDeadlineEl.textContent = 'MODALITÀ: MOSSE';
            this.gameDeadlineEl.classList.remove('danger');
        } else {
            this.gameDeadlineEl.textContent = '';
            this.gameDeadlineEl.classList.remove('danger');
        }
    }
}

onGameOverAck({ score, elapsedMs, topScores, liv }){
    this.stopTimer();
    this.startTime = Date.now() - elapsedMs;
    this.renderTimer();
    alert(`Hai completato tutti i livelli (fino al livello ${liv})! Punteggio totale: ${score} in ${(elapsedMs/1000).toFixed(1)}s`);
    this.totalScore = 0;
    this.renderStats(topScores);
    // torna al menu di scelta gioco invece di lasciare la scacchiera finita a schermo
    this.openPag('game');
}

onCampaignLost({ score, elapsedMs, liv, reason }){
    this.stopTimer();
    this.startTime = Date.now() - elapsedMs;
    this.renderTimer();
    alert(`${reason === 'moves' ? 'Mosse terminate' : 'Tempo scaduto'} al livello ${liv}. Punteggio totale: ${score}`);
    this.openPag('game');
    this.requestPlayerName();
}

onGameResult({ result, reason, score, opponentScore, elapsedMs }){
    this.stopTimer();
    this.hideWaitingIndicators();
    if(elapsedMs !== undefined){
        this.startTime = Date.now() - elapsedMs;
        this.renderTimer();
    }
    const punteggi = (score !== undefined && opponentScore !== undefined) ? ` (${score} vs ${opponentScore})` : '';
    if(result === 'win'){
        alert((reason === 'opponent-disconnected' ? 'Hai vinto! Il tuo avversario si è disconnesso.' : 'Hai vinto!') + punteggi);
    } else if(result === 'draw'){
        alert('Pareggio!' + punteggi);
    } else {
        alert('Hai perso, riprova!' + punteggi);
        this.requestPlayerName();
    }
    this.openPag('game');
}

requestPlayerName(error = ''){
    const message = `${error ? `${error}\n\n` : ''}Inserisci il tuo nome per la classifica (2–24 caratteri):`;
    const nickname = window.prompt(message, localStorage.getItem('playerName') || '');
    if(nickname === null) return;
    this.socket.emit('set score nickname', nickname);
}

onNicknameResult({ ok, nickname, error }){
    if(!ok){
        this.requestPlayerName(error || 'Nome non valido.');
        return;
    }
    localStorage.setItem('playerName', nickname);
    this.showBonusMessage(`Punteggio salvato come ${nickname}`);
}

renderStats(data){
    if(!data || !this.statsListEl) return;
    this.statsGroups = Array.isArray(data)
        ? { numberBlast: data, pairs: [], sudoku: [], escapeMath: [] }
        : (data.groups || data);
    const labels = {
        numberBlast: 'Number Blast', pairs: 'Coppie di numeri',
        sudoku: 'Sudoku', escapeMath: 'Escape Math',
    };
    if(this.leaderboardTabsEl){
        this.leaderboardTabsEl.querySelectorAll('button[data-board]').forEach(button => {
            const key = button.dataset.board;
            const rows = this.statsGroups[key] || [];
            const count = button.querySelector('small');
            if(count) count.textContent = rows.length;
            button.classList.toggle('active', key === this.activeStatsGroup);
            button.setAttribute('aria-selected', key === this.activeStatsGroup ? 'true' : 'false');
            button.onclick = () => {
                this.activeStatsGroup = key;
                this.renderStatsGroup(key, labels[key]);
            };
        });
    }
    this.renderStatsGroup(this.activeStatsGroup, labels[this.activeStatsGroup]);
}

renderStatsGroup(key, label){
    if(!this.statsGroups || !this.statsListEl) return;
    const rows = this.statsGroups[key] || [];
    if(this.leaderboardSummaryEl){
        this.leaderboardSummaryEl.textContent = `${label || key} · ${rows.length} ${rows.length === 1 ? 'giocatore mostrato' : 'giocatori mostrati'}`;
    }
    if(this.leaderboardTabsEl){
        this.leaderboardTabsEl.querySelectorAll('button[data-board]').forEach(button => {
            const active = button.dataset.board === key;
            button.classList.toggle('active', active);
            button.setAttribute('aria-selected', active ? 'true' : 'false');
        });
    }
    this.statsListEl.replaceChildren();
    rows.forEach((r, i) => {
        const item = document.createElement('li');
        const elapsed = Number(r.elapsed_ms) || 0;
        const minutes = Math.floor(elapsed / 60000);
        const seconds = Math.floor((elapsed % 60000) / 1000);
        const modeNames = {
            'pairs': 'Coppie · Single', 'pairs-1vs1': 'Coppie · 1 vs 1',
            'number-blast-1vs1': 'Number Blast · 1 vs 1', 'campaign-total': 'Number Blast',
            'campain': 'Coppie · Campagna', '1vs1': 'Coppie · 1 vs 1', 'sudoku': 'Sudoku',
            'escape-math': 'Escape Math · Single', 'escape-math-1vs1': 'Escape Math · 1 vs 1',
        };
        item.className = 'leaderboard-item';
        item.innerHTML = `<span class="rank">${i + 1}</span><span class="player"><strong></strong><small></small></span><span class="result"><strong>${Number(r.score) || 0} pt</strong><small>${minutes}:${String(seconds).padStart(2, '0')} · L${Number(r.level) || 1}</small></span>`;
        item.querySelector('.player strong').textContent = r.nickname || 'Giocatore';
        item.querySelector('.player small').textContent = modeNames[r.mode] || r.mode || 'Gioco';
        this.statsListEl.appendChild(item);
    });
    if(rows.length === 0){
        const empty = document.createElement('li');
        empty.className = 'leaderboard-empty';
        empty.textContent = 'Nessun punteggio registrato. Completa una partita per entrare in classifica!';
        this.statsListEl.appendChild(empty);
    }
}

}

</script>
