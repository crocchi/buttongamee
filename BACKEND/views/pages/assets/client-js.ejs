    case 'conf':
      this.buildPage('conf')
      break;
    case 'stat':
        this.buildPage('stat')
        break;
    case 'game':
        this.buildPage('game')
        break;
    case 'gameArea':
        this.buildPage('gameArea')
        break;
    default:
        console.log('Error Page:'+page)
      // code errore da inserire
}

}

