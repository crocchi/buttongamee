<script>

// Scena base per le "pagine modali" (ModeSelect, Settings, Stats, AdventureMap): disegna
// backdrop semi-trasparente + pannello centrale con header e bottone di chiusura, lasciando
// alle sottoclassi solo il contenuto sotto contentTop/contentBounds.
class BaseModalScene extends Phaser.Scene {
    buildChrome(title, iconLabel = ''){
        const { width, height } = this.scale;
        this.add.rectangle(0, 0, width, height, 0x05070a, 0.72).setOrigin(0).setInteractive();

        const panelWidth = Math.min(width - 40, 760);
        const panelHeight = Math.min(height - 40, 640);
        const panelX = width / 2;
        const panelY = height / 2;

        this.panel = new UIPanel(this, panelX, panelY, panelWidth, panelHeight);

        const headerY = panelY - panelHeight / 2 + 44;
        this.add.text(panelX - panelWidth / 2 + 28, headerY, iconLabel ? `${iconLabel}  ${title}` : title, {
            fontFamily: THEME.font, fontSize: '26px', fontStyle: '900', color: THEME.text,
        }).setOrigin(0, 0.5);

        new UIButton(this, panelX + panelWidth / 2 - 34, headerY, 44, 36, '✕', {
            variant: 'ghost', fontSize: 18,
            onClick: () => this.scene.stop(this.scene.key),
        });

        this.contentTop = headerY + 40;
        this.contentBounds = {
            x: panelX - panelWidth / 2 + 28,
            y: this.contentTop,
            width: panelWidth - 56,
            height: panelY + panelHeight / 2 - this.contentTop - 24,
        };
    }
}
</script>
