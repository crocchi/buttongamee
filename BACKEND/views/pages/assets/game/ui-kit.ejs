<script>

const THEME = {
    bgTop: 0x101820,
    bgBottom: 0x1b2a35,
    panel: 0x18232c,
    panelBorder: 0x2f4550,
    accent: 0x3ec6ff,
    gold: 0xffcf5c,
    success: 0x4ad991,
    danger: 0xff5d55,
    boss: 0xa564d6,
    text: '#eef3f7',
    textMuted: '#93a5b3',
    font: '"Source Sans Pro", sans-serif',
};

// Schiarisce (delta positivo) o scurisce (delta negativo) un colore impacchettato 0xRRGGBB.
function shadeColor(color, delta){
    const c = Phaser.Display.Color.ValueToColor(color);
    return Phaser.Display.Color.GetColor(
        Phaser.Math.Clamp(c.red + delta, 0, 255),
        Phaser.Math.Clamp(c.green + delta, 0, 255),
        Phaser.Math.Clamp(c.blue + delta, 0, 255),
    );
}

// Disegna una "candy" (rounded-rect con gradiente, bordo più scuro della stessa tinta, ombra
// e doppio riflesso lucido) nel Graphics dato, centrata sull'origine. Riusata dalle tessere di
// Pairs/Match3 e dai bottoni pieni: è la stessa identità visiva "candy crush" applicata a
// forme quadrate (tessere) o rettangolari (bottoni).
function drawCandyTile(g, width, height, baseColor, opts = {}){
    const radius = opts.radius ?? Math.min(width, height) * 0.2;
    const light = opts.light ?? shadeColor(baseColor, 36);
    const dark = opts.dark ?? shadeColor(baseColor, -36);
    const borderColor = opts.border ?? shadeColor(dark, -50);
    const shadow = opts.shadow !== false;
    const gloss = opts.gloss !== false;

    g.clear();
    if(shadow){
        g.fillStyle(0x000000, 0.3);
        g.fillRoundedRect(-width / 2 + 3, -height / 2 + Math.max(4, height * 0.08), width, height, radius);
    }
    g.fillGradientStyle(light, light, dark, dark, 1);
    g.fillRoundedRect(-width / 2, -height / 2, width, height, radius);
    g.lineStyle(Math.max(2, Math.min(width, height) * 0.035), borderColor, 1);
    g.strokeRoundedRect(-width / 2 + 1.5, -height / 2 + 1.5, width - 3, height - 3, Math.max(0, radius - 2));
    if(gloss){
        g.fillStyle(0xffffff, 0.28);
        g.fillEllipse(-width * 0.06, -height * 0.27, width * 0.55, height * 0.34);
        g.fillStyle(0xffffff, 0.14);
        g.fillEllipse(width * 0.22, height * 0.18, width * 0.22, height * 0.18);
    }
}

// Bottone riusabile: rounded-rect disegnato a runtime + testo, con stati hover/press.
// variant: 'primary' (azione principale) | 'ghost' (secondaria, bordo senza riempimento pieno)
// | 'success' | 'danger'.
class UIButton extends Phaser.GameObjects.Container {
    constructor(scene, x, y, width, height, label, { icon = '', variant = 'primary', onClick, fontSize = 20 } = {}){
        super(scene, x, y);
        this.btnWidth = width;
        this.btnHeight = height;
        this.variant = variant;
        this.baseFill = variant === 'ghost' ? THEME.panel
            : variant === 'danger' ? THEME.danger
            : variant === 'success' ? THEME.success
            : THEME.accent;

        this.bg = scene.add.graphics();
        this.add(this.bg);
        this.labelText = scene.add.text(0, 0, icon ? `${icon}  ${label}` : label, {
            fontFamily: THEME.font, fontSize: `${fontSize}px`, fontStyle: '700',
            color: variant === 'ghost' ? THEME.text : '#0b0f13',
        }).setOrigin(0.5);
        this.add(this.labelText);

        this.draw(1);

        this.setInteractive(
            new Phaser.Geom.Rectangle(-width / 2, -height / 2, width, height),
            Phaser.Geom.Rectangle.Contains,
        );
        this.input.cursor = 'pointer';
        this.on('pointerover', () => this.draw(1.12));
        this.on('pointerout', () => this.draw(1));
        this.on('pointerdown', () => this.draw(0.9));
        this.on('pointerup', () => { this.draw(1.12); if(onClick) onClick(); });

        scene.add.existing(this);
    }

    draw(brightness){
        this.bg.clear();
        if(this.variant === 'ghost'){
            const fill = Phaser.Display.Color.ValueToColor(this.baseFill);
            const shade = Phaser.Display.Color.GetColor(
                Math.min(255, fill.red * brightness),
                Math.min(255, fill.green * brightness),
                Math.min(255, fill.blue * brightness),
            );
            this.bg.fillStyle(shade, 1);
            this.bg.lineStyle(2, THEME.panelBorder, 1);
            this.bg.fillRoundedRect(-this.btnWidth / 2, -this.btnHeight / 2, this.btnWidth, this.btnHeight, 12);
            this.bg.strokeRoundedRect(-this.btnWidth / 2, -this.btnHeight / 2, this.btnWidth, this.btnHeight, 12);
            return;
        }
        const tint = shadeColor(this.baseFill, Math.round((brightness - 1) * 130));
        drawCandyTile(this.bg, this.btnWidth, this.btnHeight, tint, { radius: 12, shadow: false });
    }

    setLabel(text){ this.labelText.setText(text); }
}

// Interruttore on/off (toggle switch) riusabile per le impostazioni.
class UIToggle extends Phaser.GameObjects.Container {
    constructor(scene, x, y, value, onChange){
        super(scene, x, y);
        this.value = Boolean(value);
        this.trackWidth = 52;
        this.trackHeight = 28;
        this.track = scene.add.graphics();
        this.knob = scene.add.circle(0, 0, 11, 0xffffff);
        this.add([this.track, this.knob]);
        this.draw();

        this.setInteractive(
            new Phaser.Geom.Rectangle(-this.trackWidth / 2, -this.trackHeight / 2, this.trackWidth, this.trackHeight),
            Phaser.Geom.Rectangle.Contains,
        );
        this.input.cursor = 'pointer';
        this.on('pointerup', () => {
            this.value = !this.value;
            this.draw();
            if(onChange) onChange(this.value);
        });

        scene.add.existing(this);
    }

    draw(){
        this.track.clear();
        this.track.fillStyle(this.value ? THEME.success : 0x3a4750, 1);
        this.track.fillRoundedRect(-this.trackWidth / 2, -this.trackHeight / 2, this.trackWidth, this.trackHeight, this.trackHeight / 2);
        this.knob.setPosition(this.value ? this.trackWidth / 2 - 15 : -this.trackWidth / 2 + 15, 0);
    }

    setValue(value){
        this.value = Boolean(value);
        this.draw();
    }
}

// Pannello con sfondo arrotondato: base per le "pagine modali" e le card.
class UIPanel extends Phaser.GameObjects.Container {
    constructor(scene, x, y, width, height, { radius = 20, fill = THEME.panel, border = THEME.panelBorder } = {}){
        super(scene, x, y);
        const bg = scene.add.graphics();
        bg.fillStyle(fill, 0.96);
        bg.lineStyle(2, border, 1);
        bg.fillRoundedRect(-width / 2, -height / 2, width, height, radius);
        bg.strokeRoundedRect(-width / 2, -height / 2, width, height, radius);
        this.add(bg);
        this.panelWidth = width;
        this.panelHeight = height;
        scene.add.existing(this);
    }
}

// Barra informazioni in cima alle schermate di gioco vere e proprie (Pairs/Match3/Sudoku/Escape):
// titolo livello, missione/regole, riga statistiche, timer/scadenza, messaggio bonus a comparsa.
// Sotto i 560px (mobile) il blocco info scende sotto il bottone Menu invece di stargli
// accanto, e la barra cresce in altezza: senza questo, testo lungo (es. la riga statistiche)
// finiva per sovrapporsi al timer in alto a destra.
class HUDBar extends Phaser.GameObjects.Container {
    constructor(scene, { onBack } = {}){
        super(scene, 0, 0);
        const width = scene.scale.width;
        this.hudWidth = width;
        const narrow = width < 560;
        this.height = narrow ? 128 : 88;

        const bg = scene.add.graphics();
        bg.fillStyle(0x0d1318, 0.92);
        bg.fillRect(0, 0, width, this.height);
        bg.lineStyle(1, THEME.panelBorder, 1);
        bg.lineBetween(0, this.height, width, this.height);
        this.add(bg);

        this.backButton = new UIButton(scene, 66, 24, 108, 32, 'Menu', {
            icon: '‹', variant: 'ghost', fontSize: 13,
            onClick: () => { if(onBack) onBack(); },
        });
        this.add(this.backButton);

        const infoX = narrow ? 16 : 190;
        const infoY = narrow ? 48 : 12;
        const infoWidth = narrow ? width - 32 : Math.max(200, width - 420);

        this.levelText = scene.add.text(infoX, infoY, '', {
            fontFamily: THEME.font, fontSize: narrow ? '15px' : '18px', fontStyle: '900', color: THEME.text,
            wordWrap: { width: infoWidth },
        });
        this.missionText = scene.add.text(infoX, infoY + (narrow ? 22 : 24), '', {
            fontFamily: THEME.font, fontSize: '11px', color: THEME.textMuted,
            wordWrap: { width: infoWidth },
        });
        this.statsText = scene.add.text(infoX, infoY + (narrow ? 44 : 48), '', {
            fontFamily: THEME.font, fontSize: narrow ? '11px' : '13px', fontStyle: '700', color: THEME.text,
            wordWrap: { width: infoWidth },
        });
        this.add([this.levelText, this.missionText, this.statsText]);

        const timerX = width - (narrow ? 16 : 30);
        this.timerText = scene.add.text(timerX, narrow ? 16 : 18, '', {
            fontFamily: THEME.font, fontSize: narrow ? '15px' : '18px', fontStyle: '900', color: THEME.text,
        }).setOrigin(1, 0);
        this.deadlineText = scene.add.text(timerX, narrow ? 38 : 46, '', {
            fontFamily: THEME.font, fontSize: '11px', color: THEME.textMuted,
        }).setOrigin(1, 0);
        this.add([this.timerText, this.deadlineText]);

        this.bonusText = scene.add.text(width / 2, this.height + 12, '', {
            fontFamily: THEME.font, fontSize: '16px', fontStyle: '700', color: THEME.gold,
        }).setOrigin(0.5, 0).setAlpha(0);
        this.add(this.bonusText);

        scene.add.existing(this);
    }

    setLevel(text){ this.levelText.setText(text); }
    setMission(text){ this.missionText.setText(text); }
    setStats(text){ this.statsText.setText(text); }

    setTimer(text, level = 'normal'){
        this.timerText.setText(text);
        this.timerText.setColor(level === 'danger' ? '#ff5d55' : (level === 'warning' ? '#ffcf5c' : THEME.text));
    }

    setDeadline(text, danger = false){
        this.deadlineText.setText(text);
        this.deadlineText.setColor(danger ? '#ff5d55' : THEME.textMuted);
    }

    showBonus(text){
        this.bonusText.setText(text);
        this.scene.tweens.killTweensOf(this.bonusText);
        this.bonusText.setAlpha(1);
        this.scene.tweens.add({ targets: this.bonusText, alpha: 0, duration: 600, delay: 1400, ease: 'Sine.easeIn' });
    }
}

// Prompt per il nickname da salvare in classifica: stesso window.prompt() già usato dal client
// precedente (nessuna UI di input testuale da inventare per un valore così occasionale).
function requestPlayerName(error = ''){
    const message = `${error ? `${error}\n\n` : ''}Inserisci il tuo nome per la classifica (2-24 caratteri):`;
    const nickname = window.prompt(message, localStorage.getItem('playerName') || '');
    if(nickname === null) return;
    socketService.emit('set score nickname', nickname);
}

socketService.on('nicknameResult', ({ ok, nickname, error }) => {
    if(!ok){ requestPlayerName(error || 'Nome non valido.'); return; }
    localStorage.setItem('playerName', nickname);
});

// Overlay di fine partita riusato da tutte le schermate di gioco: titolo, righe di riepilogo,
// pulsante opzionale per salvare il nickname in classifica, pulsante per tornare al menu.
function showGameEndOverlay(scene, { title, lines = [], showNicknamePrompt = false, onExit }){
    const { width, height } = scene.scale;
    const overlay = scene.add.container(0, 0);
    overlay.add(scene.add.rectangle(0, 0, width, height, 0x05070a, 0.82).setOrigin(0).setInteractive());

    const panelHeight = 150 + lines.length * 26 + (showNicknamePrompt ? 56 : 0);
    const panel = new UIPanel(scene, width / 2, height / 2, Math.min(width - 60, 520), panelHeight);
    overlay.add(panel);

    const top = height / 2 - panelHeight / 2;
    overlay.add(scene.add.text(width / 2, top + 36, title, {
        fontFamily: THEME.font, fontSize: '24px', fontStyle: '900', color: THEME.text,
    }).setOrigin(0.5));

    lines.forEach((line, i) => {
        overlay.add(scene.add.text(width / 2, top + 78 + i * 26, line, {
            fontFamily: THEME.font, fontSize: '15px', color: THEME.textMuted,
        }).setOrigin(0.5));
    });

    const buttonY = top + panelHeight - (showNicknamePrompt ? 92 : 44);
    if(showNicknamePrompt){
        overlay.add(new UIButton(scene, width / 2, buttonY, 280, 40, 'Salva punteggio in classifica', {
            variant: 'success', fontSize: 14,
            onClick: () => requestPlayerName(),
        }));
    }
    overlay.add(new UIButton(scene, width / 2, buttonY + (showNicknamePrompt ? 52 : 0), 220, 40, 'Torna al menu', {
        variant: 'primary', fontSize: 14,
        onClick: () => { overlay.destroy(); if(onExit) onExit(); },
    }));

    return overlay;
}

// Piccolo screen-shake per gli errori (mismatch, mossa non valida, risposta sbagliata):
// rispetta il toggle "Animazioni" delle impostazioni come le altre animazioni di reazione.
function shakeCamera(scene, duration = 120, intensity = 0.004){
    if(!GameSettings.effectsEnabled) return;
    scene.cameras.main.shake(duration, intensity);
}

// Banner "livello superato" mostrato brevemente sopra il gioco quando Pairs/Match3/Sudoku
// passano al livello successivo. Non blocca l'input (niente backdrop interattivo): compare con
// un piccolo rimbalzo, resta un attimo, sparisce da sola mentre la partita prosegue sotto.
function showLevelUpBanner(scene, { level, score = null, title = 'LIVELLO SUPERATO!' }){
    const { width, height } = scene.scale;
    const cx = width / 2;
    const cy = height / 2 - 40;

    const container = scene.add.container(cx, cy).setScale(0.4).setAlpha(0);
    const panelWidth = 360;
    const panelHeight = score !== null ? 150 : 120;
    const bg = scene.add.graphics();
    drawCandyTile(bg, panelWidth, panelHeight, THEME.gold, {
        radius: 26, light: shadeColor(THEME.gold, 40), dark: shadeColor(THEME.gold, -30),
    });
    container.add(bg);
    container.add(scene.add.text(0, score !== null ? -38 : -24, title, {
        fontFamily: THEME.font, fontSize: '20px', fontStyle: '900', color: '#0b0f13',
    }).setOrigin(0.5));
    container.add(scene.add.text(0, score !== null ? 2 : 14, `LIVELLO ${level}`, {
        fontFamily: THEME.font, fontSize: '32px', fontStyle: '900', color: '#0b0f13',
    }).setOrigin(0.5));
    if(score !== null){
        container.add(scene.add.text(0, 44, `+${score} punti`, {
            fontFamily: THEME.font, fontSize: '15px', fontStyle: '700', color: '#3a2a00',
        }).setOrigin(0.5));
    }

    if(GameSettings.effectsEnabled){
        for(let i = 0; i < 12; i++){
            const angle = Math.random() * Math.PI * 2;
            const distance = 90 + Math.random() * 110;
            const star = scene.add.text(cx, cy, '★', {
                fontFamily: THEME.font, fontSize: `${14 + Math.random() * 14}px`, color: '#ffe36f',
            }).setOrigin(0.5).setAlpha(0);
            scene.tweens.add({
                targets: star,
                x: cx + Math.cos(angle) * distance, y: cy + Math.sin(angle) * distance,
                alpha: { from: 0, to: 1 }, angle: Phaser.Math.Between(-180, 180),
                duration: 260,
                onComplete: () => {
                    scene.tweens.add({
                        targets: star, alpha: 0, duration: 500, delay: 450,
                        onComplete: () => star.destroy(),
                    });
                },
            });
        }
    }

    scene.tweens.add({
        targets: container, scale: 1, alpha: 1, duration: 260, ease: 'Back.easeOut',
        onComplete: () => {
            scene.tweens.add({
                targets: container, alpha: 0, scale: 0.85, duration: 320, delay: 900, ease: 'Sine.easeIn',
                onComplete: () => container.destroy(),
            });
        },
    });
}

// Esito di un nodo della Mappa Avventura: sostituisce l'alert() del vecchio client con lo
// stesso overlay di fine partita, poi richiama onExit (che riporta alla mappa).
function showAdventureComplete(scene, { nodeId, stars, score }, onExit){
    sfx.levelUp();
    const starsText = '★'.repeat(stars) + '☆'.repeat(Math.max(0, 3 - stars));
    showGameEndOverlay(scene, {
        title: `Livello ${nodeId} completato!`,
        lines: [starsText, `Punteggio: ${score}`],
        showNicknamePrompt: false,
        onExit,
    });
}

function showAdventureFailed(scene, reason, onExit){
    const messages = { time: 'Tempo scaduto', moves: 'Mosse terminate', timeout: 'Tempo scaduto', lives: 'Vite terminate' };
    showGameEndOverlay(scene, {
        title: messages[reason] || 'Sfida non superata',
        lines: ['Puoi riprovare dalla mappa.'],
        showNicknamePrompt: false,
        onExit,
    });
}

// Calcola la griglia (colonne/righe/dimensione cella) che fa stare `count` elementi nell'area
// data, preferendo la cella più grande possibile: riusata da tutte le schermate a griglia
// (Pairs ora, Match3/Sudoku nelle prossime milestone).
function computeGridLayout(count, areaWidth, areaHeight, { minCell = 34, maxCell = 96, gap = 10 } = {}){
    if(count <= 0) return { cols: 0, rows: 0, cellSize: 0, gap, originX: 0, originY: 0 };
    const areaRatio = areaWidth / Math.max(1, areaHeight);
    let best = null;
    for(let cols = 1; cols <= count; cols++){
        const rows = Math.ceil(count / cols);
        const cellW = (areaWidth - gap * (cols - 1)) / cols;
        const cellH = (areaHeight - gap * (rows - 1)) / rows;
        if(cellW < minCell || cellH < minCell) continue;
        const cellSize = Math.min(maxCell, cellW, cellH);
        // a parità di cella massima, preferisce la disposizione cols/rows più vicina al
        // rapporto d'aspetto dell'area (evita colonne strette e disallineate a sinistra).
        const ratioDiff = Math.abs(Math.log((cols / rows) / areaRatio));
        const candidate = { cols, rows, cellSize, ratioDiff };
        if(!best || cellSize > best.cellSize + 0.5
            || (cellSize > best.cellSize - 0.5 && ratioDiff < best.ratioDiff)){
            best = candidate;
        }
    }
    if(!best){
        const cols = Math.max(1, Math.round(Math.sqrt((count * areaWidth) / areaHeight)));
        const rows = Math.ceil(count / cols);
        const cellSize = Math.max(16, Math.min((areaWidth - gap * (cols - 1)) / cols, (areaHeight - gap * (rows - 1)) / rows));
        best = { cols, rows, cellSize };
    }
    const gridWidth = best.cols * best.cellSize + gap * (best.cols - 1);
    const gridHeight = best.rows * best.cellSize + gap * (best.rows - 1);
    return {
        cols: best.cols, rows: best.rows, cellSize: best.cellSize, gap,
        originX: (areaWidth - gridWidth) / 2, originY: (areaHeight - gridHeight) / 2,
    };
}
</script>
